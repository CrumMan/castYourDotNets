@using System.Text.RegularExpressions
@page "/scriptures"
@rendermode InteractiveServer
@inject ScriptureService ScriptureService

<PageTitle>Scriptures</PageTitle>

<h1>Scriptures</h1>

<div class="scriptures-grid">
    <section class="card">
        <h2>@(isEditing ? "Edit Scripture" : "Add Scripture")</h2>

        <EditForm Model="currentScripture" OnValidSubmit="SaveScripture" FormName="ScriptureForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div>
                <label for="scriptureSelect">Scripture</label>
                <select id="scriptureSelect" name="scriptureSelect" @onchange="OnScriptureEnumChanged">
                    @foreach (var s in Enum.GetValues(typeof(Verse_Vault.Scripture)))
                    {
                        <option value="@s">@FormatEnumDisplay(s.ToString())</option>
                    }
                </select>
                <label for="bookSelect">Book</label>
                <select id="bookSelect" name="bookSelect"
                        @onchange="e => { selectedBook = e.Value.ToString(); UpdateChapters(); }">
                    @if (books != null && books.Any())
                    {
                        @foreach (var book in books)
                        {
                            <option value="@book">@book</option>
                        }
                    }
                </select>
            </div>

            <div>
                <label for="chapterSelect">Chapter</label>
                <select id="chapterSelect" name="chapterSelect"
                        @onchange="e => { selectedChapter = e.Value.ToString(); UpdateVerses(); }">
                    @if (chapters != null && chapters.Any())
                    {
                        @foreach (var chap in chapters)
                        {
                            <option value="@chap">@chap</option>
                        }
                    }
                </select>
                <label>:</label>
                <select id="verseSelect" name="verseSelect"
                        @onchange="e => { selectedVerse = int.Parse(e.Value.ToString()); LoadSelectedVerse(); }">
                    @if (verses != null && verses.Any())
                    {
                        @foreach (var v in verses)
                        {
                            <option value="@v">@v</option>
                        }
                    }
                </select>
            </div>

            <div>
                <label for="verseText">Text</label><br />
                <textarea id="verseText" name="verseText" value="@CleanVerseText" readonly> </textarea>
            </div>

            
        </EditForm>
    </section>

    <section class="card">
        <h2>Saved Scriptures</h2>

        @if (scriptures.Count == 0)
        {
            <p>No scriptures saved yet.</p>
        }
        else
        {
            <ul class="scripture-list">
                @foreach (var scripture in scriptures)
                {
                    <li class="scripture-item">
                        <div>
                            <p class="scripture-reference">@scripture.Reference</p>
                            <p>@scripture.Text</p>
                            @if (!string.IsNullOrWhiteSpace(scripture.Topic))
                            {
                                <p class="scripture-topic">Topic: @scripture.Topic</p>
                            }
                        </div>
                        <div class="button-row">
                            <button type="button" class="btn" @onclick="() => StartEdit(scripture)">Edit</button>
                            <button type="button" class="btn danger"
                                    @onclick="() => DeleteScripture(scripture.Id)">Delete</button>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    private List<Verse_Vault> allVerses = new();
    private List<string> books = new();
    private List<string> chapters = new();
    private List<int> verses = new();

    private Verse_Vault.Scripture? selectedScriptureEnum;
    private string selectedBook;
    private string selectedChapter;
    private int selectedVerse;

    private Verse_Vault currentVerse;

    
    private List<Scripture> scriptures = [];
    private Scripture currentScripture = new();
    private bool isEditing;
    private string CleanVerseText
    {
        get
        {
            if (currentVerse?.VerseText == null)
                return "";
            else
                return Regex.Replace(currentVerse.VerseText, @"[^\w\s]", "");
        }
    }
    private string FormatEnumDisplay(string value) =>
    Regex.Replace(value, @"(?<=[a-z])(?=[A-Z])|(?<=[a-zA-Z])(?=\d)", " ").Trim();
    protected override async Task OnInitializedAsync()
    {
        allVerses = await ScriptureService.GetAllVersesAsync();
        selectedScriptureEnum = Verse_Vault.Scripture.BookOfMormon;
        UpdateBooks();
    }

    private void OnScriptureEnumChanged(ChangeEventArgs evnt)
    {
        if (Enum.TryParse<Verse_Vault.Scripture>(evnt.Value?.ToString(), out var parsed))
        {
            selectedScriptureEnum = parsed;
        }
        UpdateBooks();
    }
    private void UpdateBooks()
    {
        books = allVerses
            .Where(v => v.scripture == selectedScriptureEnum)
            .Select(v => v.book)
            .Distinct()
            .ToList();

        if (books.Any())
        {
            selectedBook = books.First();
            UpdateChapters();
        }
    }
    private void UpdateChapters()
    {
        chapters = allVerses
        .Where(v => v.scripture == selectedScriptureEnum && v.book == selectedBook)
        .Select(v => v.Chapter.ToString())
        .Distinct()
        .OrderBy(c => int.Parse(c))
        .ToList();

        selectedChapter = chapters.FirstOrDefault() ?? "NA";
        UpdateVerses();
    }

    private void UpdateVerses()
    {
        verses = allVerses
            .Where(v => v.scripture == selectedScriptureEnum
                     && v.book == selectedBook
                     && v.Chapter.ToString() == selectedChapter)
            .Select(v => v.VerseInt)
            .OrderBy(v => v)
            .ToList();

        selectedVerse = verses.FirstOrDefault();
        LoadSelectedVerse();
    }


    private void LoadSelectedVerse()
    {
        currentVerse = allVerses.FirstOrDefault(v =>
            v.scripture == selectedScriptureEnum &&
            v.book == selectedBook &&
            v.Chapter.ToString() == selectedChapter &&
            v.VerseInt == selectedVerse);

    }



    private async Task SaveScripture()
    {
        if (isEditing)
        {
            await ScriptureService.UpdateAsync(currentScripture);
            isEditing = false;
        }
        else
        {
            await ScriptureService.AddAsync(currentScripture);
        }

        currentScripture = new Scripture();
        await RefreshScripturesAsync();
    }

    private void StartEdit(Scripture scripture)
    {
        currentScripture = new Scripture
        {
            Id = scripture.Id,
            Reference = scripture.Reference,
            Text = scripture.Text,
            Topic = scripture.Topic,
            CreatedAtUtc = scripture.CreatedAtUtc,
            IsMemorized = scripture.IsMemorized,
            PracticeCount = scripture.PracticeCount,
            CurrentStreakDays = scripture.CurrentStreakDays,
            LastPracticedAtUtc = scripture.LastPracticedAtUtc,
            MemorizedAtUtc = scripture.MemorizedAtUtc
        };
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
        currentScripture = new Scripture();
    }

    private async Task DeleteScripture(Guid id)
    {
        await ScriptureService.DeleteAsync(id);

        if (isEditing && currentScripture.Id == id)
        {
            CancelEdit();
        }

        await RefreshScripturesAsync();
    }

    private async Task RefreshScripturesAsync()
    {
        scriptures = (await ScriptureService.GetAllAsync()).ToList();
    }
}
