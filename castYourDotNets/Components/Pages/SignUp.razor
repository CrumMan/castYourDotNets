@page "/signup"

<PageTitle>Sign Up</PageTitle>

<h1>Sign Up</h1>
<div class="scriptures-grid">
    <section class="card">
        <h2>Account Information</h2>
        <EditForm model="account" FormName="AccountCreate" OnValidSubmit=AddAccount class="accountForm">

            <div>
                <label>Username
                    @* Add onchange event for checkisvalidusername *@
                <input type="text" @onchange="e => CheckIsValidUsername(e.Value.ToString())" required>
                </label>

                <label>Password
                <input type="text" required>
                </label>

                <label>Confirm Password
                <input type="text" required>
                </label>
                
                <DataAnnotationsValidator/>
                <ValidationSummary/>

                <button type="Submit" disabled=@isError>Sign Up</button>
            </div>
            
        </EditForm>
    </section>
    <section class="card">
        <h2>Why Sign Up?</h2>
        <p>Cast Your Dot Nets is a Scripture focused memory game designed to help you 
            track your practice and progress! Signing up allows you to save your scriptures
            and see how far you've gotten. It's quick, easy and free!
        </p>
    </section>
</div>

@code {
    bool isError = false;
    private UserAccount account = new UserAccount();
    private string name = "abc";

    private bool CheckIsValidUsername(string username){
        return true;
    }

    private void AddAccount() {
        return;
    }
}