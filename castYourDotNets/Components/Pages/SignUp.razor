@using System.ComponentModel.DataAnnotations
@page "/signup"
@rendermode InteractiveServer
@inject AuthUiService AuthService
@inject NavigationManager Navigation

<PageTitle>Sign Up | Verse Vault</PageTitle>

<div class="auth-shell">
    @* Left side = account creation form, right side = onboarding encouragement and scripture-centered messaging. *@
    <section class="card auth-panel">
        <div class="auth-header">
            <p class="landing-eyebrow">Create your account</p>
            <h1>Start building a scripture memorization habit today</h1>
            <p class="auth-lead">
                Create your Verse Vault account to begin saving meaningful verses and growing a steady routine of study
                and remembrance.
            </p>
        </div>

        @if (AuthService.IsAuthenticated)
        {
            <div class="auth-state">
                <p>Your account is ready, <strong>@AuthService.CurrentUsername</strong>.</p>
            </div>

            <div class="landing-actions">
                <a class="btn primary" href="/scriptures">Open Scriptures</a>
                <a class="btn" href="/progress">View Progress</a>
            </div>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="HandleSubmitAsync" FormName="SignUpForm" class="auth-form">
                <DataAnnotationsValidator />

                <div class="auth-field">
                    <label for="signup-username">Username</label>
                    <InputText id="signup-username" class="input" @bind-Value="model.Username" />
                    <ValidationMessage For="() => model.Username" />
                </div>

                <div class="auth-field">
                    <label for="signup-password">Password</label>
                    <div class="password-row">
                        <InputText id="signup-password" class="input" type="@(showPassword ? "text" : "password")"
                                   @bind-Value="model.Password" />
                        <button type="button" class="btn auth-toggle" @onclick="TogglePassword">
                            @(showPassword ? "Hide" : "Show")
                        </button>
                    </div>
                    <ValidationMessage For="() => model.Password" />
                </div>

                <div class="auth-field">
                    <label for="signup-confirm">Confirm Password</label>
                    <InputText id="signup-confirm" class="input" type="@(showConfirmPassword ? "text" : "password")"
                               @bind-Value="model.ConfirmPassword" />
                    <ValidationMessage For="() => model.ConfirmPassword" />
                </div>

                <p class="auth-note">Use at least 8 characters with letters and numbers.</p>

                @if (errorMessages.Count > 0)
                {
                    <div class="auth-errors">
                        <ul>
                            @foreach (var message in FlattenErrors())
                            {
                                <li>@message</li>
                            }
                        </ul>
                    </div>
                }

                <div class="landing-actions auth-actions">
                    <button type="submit" class="btn primary" disabled="@isSubmitting">
                        @(isSubmitting ? "Creating Account..." : "Create Account")
                    </button>
                    <a class="btn" href="/signin">Already have an account?</a>
                </div>

                <p class="auth-link-row">
                    Your progress stays tied to your session and is designed to support a personal, scripture-centered
                    routine.
                </p>
            </EditForm>
        }
    </section>

    <aside class="card auth-aside">
        <p class="landing-eyebrow">A better way to begin</p>
        <h2>Make memorization simple, meaningful, and consistent.</h2>
        <ul class="auth-benefits">
            <li>Choose verses that touch your heart</li>
            <li>Practice one step at a time</li>
            <li>Watch your confidence and consistency grow</li>
        </ul>

        <blockquote class="card quote-card quote-card-featured">
            <p>“I think it is very helpful if you begin today to learn a few of the teachings of Jesus Christ and have
                them in your memory.”</p>
                <footer>— Elder Neil L. Andersen</footer>
            </blockquote>
        </aside>
    </div>

@code {
    private readonly SignUpModel model = new();
    private Dictionary<string, string[]> errorMessages = [];
    private bool isSubmitting;
    private bool showPassword;
    private bool showConfirmPassword;

    private async Task HandleSubmitAsync()
    {
        isSubmitting = true;
        errorMessages = [];

        var result = await AuthService.RegisterAsync(model.Username, model.Password);

        isSubmitting = false;

        if (result.Succeeded)
        {
            Navigation.NavigateTo("/scriptures");
            return;
        }

        errorMessages = result.Errors;
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
        showConfirmPassword = !showConfirmPassword;
    }

    private IEnumerable<string> FlattenErrors() => errorMessages.SelectMany(entry => entry.Value);

    private sealed class SignUpModel
    {
        [Required(ErrorMessage = "Username is required.")]
        [StringLength(32, MinimumLength = 3, ErrorMessage = "Username must be 3 to 32 characters.")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters long.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password.")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
