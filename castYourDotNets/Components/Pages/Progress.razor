@page "/dashboard"
@page "/progress"
@rendermode InteractiveServer
@* This page doubles as both /dashboard and /progress so signed-in users have one polished home screen. *@
@inject ScriptureService ScriptureService
@inject AuthUiService AuthService
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-page">
    <section class="card dashboard-hero">
        <div>
            <p class="landing-eyebrow">Signed-in dashboard</p>
            <h1>Welcome back, @(AuthService.CurrentUsername ?? "Friend")</h1>
            <p class="helper-text">
                Track your memorization progress, monitor your streaks, and choose your next best study step.
            </p>
        </div>

        <div class="dashboard-actions">
            <a class="btn primary" href="/practice">Practice Now</a>
            <a class="btn" href="/scriptures">Add Scripture</a>
        </div>
    </section>

    @if (scriptures.Count == 0)
    {
        <section class="card empty-state">
            <h2>Your dashboard is ready</h2>
            <p>Start by adding your first scripture, then come back here to watch your progress grow over time.</p>
            <div class="landing-actions">
                <a class="btn primary" href="/scriptures">Add Your First Scripture</a>
            </div>
        </section>
    }
    else
    {
        <section class="dashboard-stats-grid">
            <article class="card summary-card">
                <p class="summary-label">Total Scriptures</p>
                <p class="summary-number">@totalScriptures</p>
            </article>
            <article class="card summary-card">
                <p class="summary-label">Memorized</p>
                <p class="summary-number">@memorizedCount</p>
            </article>
            <article class="card summary-card">
                <p class="summary-label">Practice Attempts</p>
                <p class="summary-number">@totalPracticeCount</p>
            </article>
            <article class="card summary-card">
                <p class="summary-label">Best Streak</p>
                <p class="summary-number">@bestStreak</p>
            </article>
        </section>

        <section class="card">
            <div class="dashboard-card-header">
                <div>
                    <p class="landing-eyebrow">Progress overview</p>
                    <h2>Scripture status</h2>
                </div>

                <span class="status-chip info">@completionRate% memorized</span>
            </div>

            <ul class="scripture-list">
                @foreach (var scripture in scriptures.OrderByDescending(s => s.PracticeCount).ThenBy(s => s.Reference))
                {
                    <li class="scripture-item">
                        <div class="scripture-item-top">
                            <div>
                                <p class="scripture-reference">@scripture.Reference</p>
                                <p class="scripture-topic">@scripture.Book @scripture.Chapter:@scripture.VerseNumber</p>
                            </div>

                            <span class="status-chip @(scripture.IsMemorized ? "success" : "info")">
                                @(scripture.IsMemorized ? "Memorized" : "In Progress")
                            </span>
                        </div>

                        <div class="list-meta">
                            <span>Attempts: @scripture.PracticeCount</span>
                            <span>Current streak: @scripture.CurrentStreakDays day(s)</span>
                        </div>
                    </li>
                }
            </ul>
        </section>
    }
</div>

@code {
    private List<Scripture> scriptures = [];

    private int totalScriptures;
    private int memorizedCount;
    private int practicedCount;
    private int totalPracticeCount;
    private int bestStreak;
    private int completionRate;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/signin");
            return;
        }

        await RefreshAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        scriptures = (await ScriptureService.GetAllAsync()).ToList();
        totalScriptures = scriptures.Count;
        memorizedCount = scriptures.Count(s => s.IsMemorized);
        practicedCount = scriptures.Count(s => s.PracticeCount > 0);
        totalPracticeCount = scriptures.Sum(s => s.PracticeCount);
        bestStreak = scriptures.Count == 0 ? 0 : scriptures.Max(s => s.CurrentStreakDays);
        completionRate = totalScriptures == 0 ? 0 : (int)Math.Round(memorizedCount * 100d / totalScriptures);
    }
}
