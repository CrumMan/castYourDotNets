@page "/login"
@using castYourDotNets.Contracts
@inject HttpClient Http
@inject NavigationManager Navigation

@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@using Microsoft.AspNetCore.Components.Forms

@inject ProtectedSessionStorage SessionStorage
@using Microsoft.AspNetCore.Mvc

<h3 class="title">Login</h3>

<EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm" class="form">

    <DataAnnotationsValidator />

    <div class="form-group">
        <label>Username:</label>
        <InputText @bind-Value="loginModel.Username" @bind-Value:event="oninput" class="input" autofocus />
        <ValidationMessage For="@(() => loginModel.Username)" />
    </div>

    <div class="form-group">
        <label>Password:</label>
        <InputText @bind-Value="loginModel.Password" type="password" @bind-Value:event="oninput" class="input" />
        <ValidationMessage For="@(() => loginModel.Password)" />
    </div>

    <p>Username: @loginModel.Username</p>
    <p>Password: @loginModel.Password</p>

    <button type="submit" class="btn">Login</button>
</EditForm>

@if (!string.IsNullOrEmpty(loginModel.ServerError))
{
    <p style="color:red">@loginModel.ServerError</p>
}

@code {
    private LoginModel loginModel = new();
    private bool loginCompleted = false;
    private string authToken = string.Empty;
    private string Username = string.Empty;

    private async Task HandleLogin()
    {
        Console.WriteLine($"Username: {loginModel.Username}");
        Console.WriteLine($"Password: {loginModel.Password}");
        loginModel.ServerError = null;

        try
        {
            var response = await Http.PostAsJsonAsync("/api/accounts/login", new LoginRequest
            {
                Username = loginModel.Username,
                Password = loginModel.Password
            });

            if (!response.IsSuccessStatusCode)
            {
                var problem = await response.Content.ReadFromJsonAsync<ValidationProblemDetails>();

                loginModel.ServerError =
                    problem?.Errors.Values.SelectMany(e => e).FirstOrDefault()
                    ?? "Login failed.";

                return;
            }

            var result = await response.Content.ReadFromJsonAsync<AuthenticationResponse>();

            if (result == null || string.IsNullOrEmpty(result.AccessToken))
            {
                loginModel.ServerError = "Invalid username or password.";
                return;
            }

            authToken = result.AccessToken;
            Username = result.Account.Username;
            loginCompleted = true;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            loginModel.ServerError = $"Login error: {ex.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loginCompleted)
        {
            // Save token and username safely (JS interop) after render
            await SessionStorage.SetAsync("authToken", authToken);
            await SessionStorage.SetAsync("Username", Username);

            // Redirect to home
            Navigation.NavigateTo("/");
            loginCompleted = false;
        }
    }
}