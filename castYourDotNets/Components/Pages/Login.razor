@page "/login"
@using castYourDotNets.Contracts
@inject HttpClient Http
@inject NavigationManager Navigation

@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@using Microsoft.AspNetCore.Components.Forms

@inject ProtectedSessionStorage SessionStorage

<h3 class="title">Login</h3>

@* <EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm" class="form"> *@
<EditForm Model="loginModel" FormName="LoginForm" class="form">

    <DataAnnotationsValidator />

    <div class="form-group">
        <label>Username:</label>
        <InputText @bind-Value="loginModel.Username" @bind-Value:event="oninput" class="input" autofocus />
        <ValidationMessage For="@(() => loginModel.Username)" />
    </div>

    <div class="form-group">
        <label>Password:</label>
        <InputText @bind-Value="loginModel.Password" type="password" @bind-Value:event="oninput" class="input" />
        <ValidationMessage For="@(() => loginModel.Password)" />
    </div>

    <p>Username: @loginModel.Username</p>

    <button type="submit" class="btn" @onclick="HandleLogin">Login</button>
</EditForm>

@if (!string.IsNullOrEmpty(loginModel.ServerError))
{
    <p style="color:red">@loginModel.ServerError</p>
}

@code {
    private LoginModel loginModel = new();
    private bool loginCompleted = false;
    private string authToken = string.Empty;
    private string username = string.Empty;

    private async Task HandleLogin()
    {
        loginModel.ServerError = null; // Clear previous errors

        try
        {
            var response = await Http.PostAsJsonAsync("api/accounts/login", loginModel);

            if (!response.IsSuccessStatusCode)
            {
                loginModel.ServerError = "Login failed. Try again.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<AuthenticationResponse>();

            if (result == null || string.IsNullOrEmpty(result.AccessToken))
            {
                loginModel.ServerError = "Invalid username or password.";
                return;
            }

            // Store locally for prerender-safe session storage
            authToken = result.AccessToken;
            username = result.Account.Username;
            loginCompleted = true;

            // Trigger session storage write after render
            StateHasChanged();
        }
        catch (Exception ex)
        {
            loginModel.ServerError = $"Login error: {ex.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loginCompleted)
        {
            // Save token and username safely (JS interop) after render
            await SessionStorage.SetAsync("authToken", authToken);
            await SessionStorage.SetAsync("username", username);

            // Redirect to home
            Navigation.NavigateTo("/");
            loginCompleted = false;
        }
    }
}